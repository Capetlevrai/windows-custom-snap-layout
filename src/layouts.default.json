// CustomFancyZone : le menu qui s'ouvre quand la souris reste sur le bouton Agrandir d'une fenêtre.
// Ce fichier est relu automatiquement à chaque enregistrement. Documentation : README.md
{
  // Temps de survol du bouton avant l'ouverture du menu (millisecondes).
  "hoverDelayMs": 400,
  // Temps avant fermeture quand la souris quitte le menu (millisecondes).
  "hideDelayMs": 350,
  // Nombre de vignettes par ligne dans le menu (3, comme Windows).
  "columns": 3,
  // Largeur d'une vignette, en pixels à 100 % (multipliée par la mise à l'échelle de l'écran).
  "tileWidth": 96,
  // Espace entre les fenêtres placées et autour d'elles, en pixels à 100 %. 0 = collées, comme Windows.
  "zoneGap": 0,
  // Montre sur l'écran la zone survolée avant de cliquer.
  "showPreview": true,
  // Affiche le nom de la disposition survolée en bas du menu.
  "showNames": true,
  // Après le placement, propose les autres fenêtres ouvertes pour remplir les zones vides (comme Windows).
  "snapAssist": true,
  // Case « Zoom » (− · ↺ · +) à droite de la dernière disposition : zoome la fenêtre survolée (Ctrl − / Ctrl 0 / Ctrl +).
  "showZoomBar": true,
  // Applications qui dessinent leur bouton Agrandir sans le déclarer à Windows : classe de la fenêtre et position
  // du bouton en pixels à 100 %, depuis le coin haut-droit (right = distance au bord droit).
  "customButtons": [
    { "windowClass": "UnrealWindow", "right": 42, "top": 0, "width": 42, "height": 30 }
  ],
  // Journal détaillé dans CustomFancyZone.log (diagnostic).
  "debugLog": false,

  // Chaque disposition se décrit soit par "grid" (un dessin en lettres), soit par "zones" ([x, y, largeur, hauteur] en %).
  // Dans "grid" : une lettre = une zone, toutes les colonnes ont la même largeur, "." = case vide.
  // "zoom" (facultatif) : zoom en % de la fenêtre placée dans chaque zone, null = inchangé.
  //   Ex. "zoom": [null, 80] → la fenêtre de droite passe à 80 % (paliers Chrome : 67, 75, 80, 90, 100, 110…).
  "layouts": [
    { "name": "50 / 50", "grid": ["AB"] },
    { "name": "55 / 45", "zones": [[0, 0, 55, 100], [55, 0, 45, 100]] },
    { "name": "60 / 40", "zones": [[0, 0, 60, 100], [60, 0, 40, 100]] },

    { "name": "Deux tiers | un tiers", "grid": ["AAB"] },
    { "name": "68 / 32", "zones": [[0, 0, 68, 100], [68, 0, 32, 100]] },
    { "name": "74 / 26", "zones": [[0, 0, 74, 100], [74, 0, 26, 100]] },

    { "name": "80 / 20", "zones": [[0, 0, 80, 100], [80, 0, 20, 100]] },
    { "name": "Quatre quarts", "grid": ["AB", "CD"] }
  ]
}
